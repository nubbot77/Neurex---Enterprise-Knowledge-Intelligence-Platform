# Copy to .env and fill in real values. Never commit .env.
# Consumed by docker-compose.yml (Compose reads .env from this directory).

# ==========================================
# PostgreSQL
# ==========================================
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rag_platform
# Host-side port only. Change if 5432 is taken by a local Postgres install.
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432

# ==========================================
# Redis
# ==========================================
REDIS_PASSWORD=change_me
# Change if 6379 is taken by a local Redis install/service.
REDIS_PORT=6380

# ==========================================
# Qdrant
# ==========================================
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
