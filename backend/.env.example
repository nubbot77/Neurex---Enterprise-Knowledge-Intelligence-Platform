# Copy to .env and fill in real values. Never commit .env.
# Read by pydantic-settings (config/settings.py) at app startup.
# In cloud deployments this file is absent — the platform injects these as
# OS environment variables, which take priority over any .env file.

# ==========================================
# App
# ==========================================
ENVIRONMENT=development
LOG_LEVEL=INFO

# ==========================================
# Datastores
# Host "localhost" when running the API on the host against Docker containers.
# Swap to the compose service names (postgres/redis/qdrant) when the API itself
# runs inside docker-compose.
# ==========================================
# App traffic goes through PgBouncer (6432).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:6432/DBNAME
# Alembic connects to Postgres directly (5432): DDL and advisory locks need a
# connection that stays put, which PgBouncer's transaction mode cannot provide.
MIGRATION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/DBNAME
REDIS_URL=redis://:PASSWORD@localhost:6379/0
QDRANT_URL=http://localhost:6333

# ==========================================
# Auth
# Generate per environment: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ==========================================
JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==========================================
# Providers (fill when Phase 12 / Phase 19 land)
# ==========================================
LLM_API_KEY=
LLM_BASE_URL=
EMBEDDING_API_KEY=

# ==========================================
# Object storage (Phase 6)
# ==========================================
# Leave empty and the API still boots — it logs storage.unconfigured at startup and
# every document route answers 503. Everything else keeps working.
#
# Local development uses the `minio` service in docker-compose.yml, which speaks S3
# exactly as R2 does — only these four values change between them. Create the bucket
# once with: cd backend && uv run python scripts/ensure_bucket.py
#
#   STORAGE_BUCKET=neurex-documents
#   STORAGE_ENDPOINT_URL=http://127.0.0.1:9010
#   STORAGE_ACCESS_KEY_ID / SECRET   = MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (root .env)
#   STORAGE_REGION=us-east-1         (MinIO wants a real region name)
STORAGE_BUCKET=
# R2: https://<account id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# R2 has one region and calls it "auto". A real S3 bucket needs its own.
STORAGE_REGION=auto
# Upload ceiling in bytes, enforced against bytes actually read. Default 100 MiB.
MAX_UPLOAD_BYTES=104857600
